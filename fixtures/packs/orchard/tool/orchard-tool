#!/bin/sh
# The surveyor of the invented orchard pack. It implements no rule: tool/answers/<name>.json is
# its survey of orchards/<name>.yaml, printed as it is. An orchard without such a file is sound.
# It is started as `sh tool/orchard-tool`.
#
#   orchard-tool survey <orchard>
#
# Prints one JSON object and exits 0, whatever the verdict. Exit 3 with {"problem": ...} when
# the orchard cannot be read.

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

fail() {
  printf '{"problem": "%s"}\n' "$1"
  exit 3
}

[ "${1:-}" = survey ] || fail "usage: orchard-tool survey <orchard>"
[ $# -eq 2 ] || fail "survey takes one orchard"
[ -f "$2" ] || fail "no such orchard"
name=$(basename -- "$2" .yaml)
if [ -f "$here/answers/$name.json" ]; then
  cat "$here/answers/$name.json"
else
  printf '{"orchard": "%s", "verdict": "sound", "observations": []}\n' "$name"
fi
