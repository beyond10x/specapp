{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beyond10x/specapp/schema/specapp-pack-2.schema.json",
  "title": "specapp-pack/2",
  "description": "specapp's manifest of a pack: packs/<name>.yaml for a public pack specapp knows, a file given at run time for any other. It lies outside the pack. Every path is relative to the pack directory and stays inside it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "pack", "title", "visibility", "blocks"],
  "properties": {
    "format": { "const": "specapp-pack/2" },
    "pack": { "$ref": "#/$defs/name" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "visibility": { "enum": ["public", "private"] },
    "source_url": { "type": "string", "pattern": "^https://" },
    "extends": {
      "description": "The name of the public pack this pack builds on: a pack specapp knows (packs/<name>.yaml), or one whose manifest is given at run time (--extends).",
      "$ref": "#/$defs/name"
    },
    "blocks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "strip_prefix": { "type": "string", "minLength": 1 }
      }
    },
    "kpis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "fields": {
          "description": "The pack's names of the neutral KPI fields. Default: measure and modes.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "measure": { "$ref": "#/$defs/key" },
            "modes": { "$ref": "#/$defs/key" }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/document_class" }
    },
    "tool": {
      "description": "The pack's own tool and, per verb specapp offers, the adapter that runs it and maps its answer. The tool knows nothing of specapp.",
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": {
        "run": {
          "description": "The argv prefix of the pack's tool. A first element with a slash is a path inside the pack; any other is looked up on PATH.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "verbs": {
          "description": "The verbs the tool is used for, each with its adapter.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "check": { "$ref": "#/$defs/check_adapter" }
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "families": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/key" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["blocks", "colour", "icon"],
            "properties": {
              "blocks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/key" }
              },
              "colour": { "$ref": "#/$defs/colour" },
              "icon": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
            }
          }
        },
        "vocabulary": {
          "description": "Display words for block names and link names. The identifier stays visible.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/key" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "pointer": {
      "description": "A JSON pointer (RFC 6901): empty for the whole value, else starting with a slash.",
      "type": "string",
      "pattern": "^(/.*)?$"
    },
    "template": {
      "description": "A text in which {<JSON pointer>} stands for the text at that pointer in one entry of the answer.",
      "type": "string"
    },
    "test": {
      "description": "A truth read from the answer: the boolean at `at`, or whether the value at `at` equals `equals`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["at"],
      "properties": {
        "at": { "$ref": "#/$defs/pointer" },
        "equals": {}
      }
    },
    "check_adapter": {
      "description": "How specapp checks one document with the pack's tool: it runs `<tool.run> <args> <document>` in the pack directory, reads stdout as JSON and maps the result. Every pointer but `at` is relative to the result.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "args": {
          "description": "The arguments after tool.run; the document's path is appended.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exit": {
          "description": "The exit codes that come with an answer. Default: [0].",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "at": {
          "description": "Where the document's result is in the answer. Default: the whole answer.",
          "$ref": "#/$defs/pointer"
        },
        "error": {
          "description": "A text here refuses the run with that text, whatever the exit code.",
          "$ref": "#/$defs/pointer"
        },
        "valid": {
          "description": "Whether the document is valid. Default: valid when no finding is gated.",
          "$ref": "#/$defs/test"
        },
        "counts": {
          "description": "Findings per rule: a mapping from a rule to a count. Left out of the answer: no counts.",
          "$ref": "#/$defs/pointer"
        },
        "findings": {
          "description": "The lists of findings in the result, in the order they are shown.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "rule", "gate", "message", "subject"],
            "properties": {
              "at": {
                "description": "The list. Left out of the answer: empty.",
                "$ref": "#/$defs/pointer"
              },
              "rule": { "$ref": "#/$defs/template" },
              "gate": {
                "description": "Whether the finding is gated: always, never, or as a test of the entry says.",
                "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/test" }]
              },
              "message": { "$ref": "#/$defs/template" },
              "subject": {
                "description": "What the finding is about: always the document, or a rule over the entry.",
                "oneOf": [
                  { "const": "document" },
                  { "$ref": "#/$defs/subject_rule" }
                ]
              }
            }
          }
        }
      }
    },
    "subject_rule": {
      "description": "The id of a part or a link. With link_when_contains an id that contains the text is a link, any other a part; with kind the template's value is looked up in kinds (a value not listed: the document); with neither the id is a part. unknown: document makes an id the drawn graph does not have a finding about the document, the id put before the message unless it is the document's name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/template" },
        "link_when_contains": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/template" },
        "kinds": {
          "type": "object",
          "additionalProperties": { "enum": ["part", "link", "document"] }
        },
        "unknown": { "enum": ["keep", "document"] }
      },
      "not": { "required": ["link_when_contains", "kind"] },
      "dependentRequired": { "kind": ["kinds"], "kinds": ["kind"] }
    },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
    "path": {
      "description": "A relative path or glob inside the pack: no leading slash, no .. component.",
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/)|(^\\.\\.(/|$))|(/\\.\\.(/|$))|\\\\" }
    },
    "colour": {
      "description": "A colour of specapp's palette. A pack never writes a colour value.",
      "enum": ["blue", "violet", "green", "teal", "amber", "orange", "red", "pink", "cyan", "lime", "brown", "slate"]
    },
    "document_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "title", "paths", "shape", "name"],
      "properties": {
        "class": { "$ref": "#/$defs/key" },
        "title": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/path" }
        },
        "shape": { "enum": ["parts-links/1", "records/1"] },
        "name": {
          "description": "The key of a document that holds its name.",
          "$ref": "#/$defs/key"
        },
        "contain": {
          "description": "How one part contains another: `in` names the field of a part that names the part it sits in; `per` names the field of a part that names the part it exists once per instance of.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "in": { "$ref": "#/$defs/key" },
            "per": { "$ref": "#/$defs/key" }
          }
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "layout"],
            "properties": {
              "id": { "$ref": "#/$defs/key" },
              "title": { "type": "string", "minLength": 1 },
              "layout": { "enum": ["rows", "nested"] },
              "rows": {
                "description": "For layout rows: a part's row is the layer of its block (`layer`, the default) or the row of its block's family (`family`).",
                "enum": ["layer", "family"]
              },
              "blocks": { "type": "array", "items": { "$ref": "#/$defs/key" } },
              "carries": { "type": "array", "items": { "$ref": "#/$defs/key" } }
            }
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "at", "columns"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "at": { "$ref": "#/$defs/key" },
              "key": { "$ref": "#/$defs/key" },
              "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/key" } }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "shape": { "const": "records/1" } } },
          "then": { "not": { "anyOf": [{ "required": ["contain"] }, { "required": ["views"] }] } }
        },
        {
          "if": { "properties": { "shape": { "const": "parts-links/1" } } },
          "then": { "not": { "required": ["tables"] } }
        }
      ]
    }
  }
}
