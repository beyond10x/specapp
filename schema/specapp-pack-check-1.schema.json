{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beyond10x/specapp/schema/specapp-pack-check-1.schema.json",
  "title": "specapp-pack-check/1",
  "description": "What `specapp pack check --json` prints: whether a pack loads, its counts, and what specapp has to say about it. A refused pack has errors and no counts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "valid", "errors", "warnings"],
  "properties": {
    "format": { "const": "specapp-pack-check/1" },
    "valid": { "type": "boolean" },
    "pack": { "type": "string" },
    "title": { "type": "string" },
    "visibility": { "enum": ["public", "private"] },
    "extends": { "type": "string" },
    "level": {
      "description": "The highest level of adoption the manifest declares: L0 blocks, L1 KPIs, L2 documents, L3 check, L4 runs, L5 edit.",
      "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocks", "layers", "kpis", "planned_blocks", "document_classes", "documents"],
      "properties": {
        "blocks": { "$ref": "#/$defs/count" },
        "layers": { "$ref": "#/$defs/count" },
        "kpis": { "$ref": "#/$defs/count" },
        "planned_blocks": {
          "description": "Blocks the KPI catalogue names that the blocks do not have yet.",
          "$ref": "#/$defs/count"
        },
        "document_classes": { "$ref": "#/$defs/count" },
        "documents": { "$ref": "#/$defs/count" }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "name", "blocks"],
        "properties": {
          "number": { "$ref": "#/$defs/count" },
          "name": { "type": "string" },
          "blocks": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "shape", "documents"],
        "properties": {
          "class": { "type": "string" },
          "shape": { "enum": ["parts-links/1", "records/1"] },
          "documents": { "$ref": "#/$defs/count" }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "run": { "type": "array", "items": { "type": "string" } },
        "verbs": { "type": "array", "items": { "type": "string" } },
        "state": {
          "description": "none: the manifest names no tool. found: the program exists; specapp ran nothing. not_found: the program cannot be started.",
          "enum": ["none", "found", "not_found"]
        }
      }
    },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
  },
  "allOf": [
    {
      "if": { "properties": { "valid": { "const": true } } },
      "then": {
        "required": ["pack", "title", "visibility", "level", "counts", "layers", "documents", "tool"],
        "properties": { "errors": { "maxItems": 0 } }
      },
      "else": { "properties": { "errors": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "subject", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "subject": {
          "description": "manifest, path:<path>, block:<name>, kpi:<id>, class:<class>, document:<path>, family:<name>, view:<class>/<id> or tool:<program>.",
          "type": "string"
        },
        "message": { "type": "string" }
      }
    }
  }
}
